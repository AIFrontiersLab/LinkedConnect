{
  "name": "linkedmaven-connect",
  "version": "1.0.0",
  "private": true,
  "description": "LinkedMaven Connect: a local Chrome extension for tracking LinkedIn connection requests and follow-ups",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm test && vite build",
    "e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
